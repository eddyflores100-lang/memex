{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.eddyflores100-lang/memex-memory",
  "title": "Memex",
  "description": "Recall locally stored agent memories through an MCP-compatible host.",
  "websiteUrl": "https://github.com/eddyflores100-lang/memex",
  "repository": {
    "url": "https://github.com/eddyflores100-lang/memex",
    "source": "github"
  },
  "version": "0.3.0rc1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "memex-memory",
      "version": "0.3.0rc1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "memex-memory==0.3.0rc1"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "memex"
        },
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MEMEX_PORT",
          "description": "Port of the local memex-server process (default: 19420).",
          "format": "number"
        }
      ]
    }
  ]
}
